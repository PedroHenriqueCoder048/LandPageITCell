@page
@model IndexModel

@section Styles {
    <link rel="stylesheet" href="~/css/home.css"/>
}

@{
    ViewData["Title"] = "Home page";
}

<body>
    <div class="div-container-main">
        <section id="section-initial">
            <div class="div-section-initial">
                <div>
                    <h1 class="">
                    Seu celular quebrou?
                    </h1>
                    <hr >
                    <p>
                        Não compre outro, nós devolvemos a vida a ele hoje mesmo.
                    </p>
                    <form action="#">
                        <input class="btn-whatsapp" type="submit" value="WhatsApp"/>
                    </form>
                </div>
                <div>
                    <img src="" alt="">
                    <h3>imagem ilustrativa</h3>
                </div>
            </div>
        </section>

        <section id="section-history">
            <div class="div-section-history">
                    <div class="div-section-history-content-text">
                        <h2>Nossa história</h2>
                        <hr >
                        <p>
                            "Nascemos do desejo do nosso fundador, Iodaliel Rodrigues, de conectar pessoas através da tecnologia. Tudo começou de forma simples, em um pequeno box no bairro do Jurunas, impulsionado pela paixão por resolver problemas e ajudar a comunidade.
                            Com muita dedicação e a confiança dos nossos clientes, a nossa história se expandiu. Hoje, com três lojas localizadas na Pratinha e no Cordeiro, mantemos o mesmo compromisso do primeiro dia: o de devolver a vida aos aparelhos que guardam as suas melhores memórias."
                        </p>
                    </div>
                    <div class="div-section-history-content-img">
                        <img src="
                        https://images.unsplash.com/photo-1566728595333-75a1d7cae961?w=800&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D

                        " 
                        alt="Sr.Iodaliel Rodrigues(fundador)"/>
                        <h5>Iodaliel Rodrigues</h5>
                    </div>
            </div>
        </section>

        <section id="section-services">
            <h3>Serviços que realizamos para você</h3>

            <div class="div-section-services">
                <div class="div-section-services-content">

                    <div class="div-card">
                        <img src="
                        https://images.unsplash.com/photo-1566728595333-75a1d7cae961?w=800&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D
                        " alt="">
                        <h4>Reparo de telas</h4>
                        <p>Restauramos a imagem e o toque do seu aparelho com alta precisão.</p>
                    </div>

                    <div class="div-card">
                        <img src="
                        https://images.unsplash.com/photo-1746005514011-ea00280f3b6e?w=800&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D
                        " alt="">
                        <h4>Troca de baterias</h4>
                        <p>Devolvemos a autonomia para o seu celular não te deixar na mão.</p> 
                    </div>

                    <div class="div-card">
                        <img src="
                        https://plus.unsplash.com/premium_photo-1664299444861-f8b8b9d8f004?w=800&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D
                        " alt="">
                        <h4>Reparo de placas</h4>
                        <p>Soluções avançadas para problemas complexos de inicialização e circuito.</p>
                    </div>
                    <div class="div-card">
                        <img src="
                        https://images.unsplash.com/photo-1653548147626-d3ca2bd24cb6?w=800&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D
                        " alt="">
                        <h4>Renovação de carcaça</h4>
                        <p>Restauramos a imagem e o toque do seu aparelho com alta precisão.</p>
                    </div>

                    <div class="div-card">
                        <img src="" alt="">
                        <h4>Reparo de conectores</h4>
                        <p>Problemas ao carregar? Recuperamos o funcionamento do conector do seu celular.</p>
                    </div>

                    <div class="div-card">
                        <img src="" alt="">
                        <h4>Backup e recuperação</h4>
                        <p>Suas memórias são importantes! Realizamos backup e recuperação de dados para ajudar a manter seus arquivos protegidos.</p>
                    </div>
                    <div class="div-card">
                        <img src="" alt="">
                        <h4>Desoxidação</h4>
                        <p>a salvação para eletrônicos que tiveram contato com líquidos.</p>
                    </div>
                    <div class="div-card">
                        <img src="" alt="">
                        <h4>Delivery</h4>
                        <p>Concertamos seu celular sem você sair de casa, buscamos e entregamos no seu endereço com total segurança.</p>
                    </div>
                </div>
            </div>
        </section>
        <section id="section-products">
            <div>
                <h3>Produtos</h3>
                <h3>Em breve</h3>
            </div>
        </section>
        <section id="section-contacts">
            <div class="div-container-contacts">
                <h3>Contatos</h3>
                <div class="div-container-contacts-social-media">
                    <p>Instagram</p>
                    <p>WhatsApp</p>
                    <p>Facebook</p>
                </div>
                <div class="div-form-clint">
                    <form class="form-client" mathod="post" action="#">
                        <h4>Fale com o suporte por E-mail</h4>
                        <label for="nome">Nome</label>
                        <input type="text" id="name" placeholder="Nome do contato" required/>
                        <label for="email">E-mail</label>
                        <input type="email" id="email" placeholder="exemplo@gmail.com" required/>
                        <label for="fone">Telefone</label>
                        <input type="tel" id ="fone" placeholder="(91) 99999-9999"/>
                        <label for="whats">Contato possui WhatsApp</label>
                        <input type="checkbox" for="whats"/>
                        <label for="doubt">Dúvidas</label>
                        <textarea id="doubt" rows="10" cols="1" placeholder="Escreva sua mensagem aqui" required></textarea>
                        <input class="form-client-btn" type="submit" value="Envia"/>
                    </form>
                </ldiv>
            </div>
        </section>
        <section id="section-map">
            <div>
                <h3>Localização</h3>
                <div class="div-container-map">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3988.6921365109183!2d-48.47039222717283!3d-1.3613692297705706!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x92a4616e471b27e1%3A0x5626db919b8be0c4!2sITCELL%20-%20Loja%20de%20Acess%C3%B3rios%20e%20Assist%C3%AAncia%20T%C3%A9cnica%20para%20Celular!5e0!3m2!1spt-BR!2sbr!4v1794254412540!5m2!1spt-BR!2sbr" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
                </div>
            </div>
        </section>

    </div>
</body>